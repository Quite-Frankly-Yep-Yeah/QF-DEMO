<%
  add_crumb(@quiz.quiz_title, context_url(@context, :context_quiz_url, @quiz))
  provide :page_title, join_title(@quiz.quiz_title, @context.name)
  css_bundle :quizzes
  review_items = SelfPaced::RetakeRules.review_items_to_revisit(@quiz, @current_user)
%>

<div style="max-width: 600px; margin: 10px auto;">
  <h2><%= @quiz.quiz_title || @quiz.readable_type %></h2>
  <p><%= t("Your last try didn't reach mastery yet. Go back over the lesson before you try again:") %></p>
  <ul>
    <% review_items.each do |tag| %>
      <li>
        <a href="<%= course_context_modules_item_redirect_path(course_id: @context.id, id: tag.id) %>"><%= tag.title %></a>
      </li>
    <% end %>
  </ul>
  <p><%= t("Once you've reopened the lesson, come back here to start your next try.") %></p>
</div>
